PORT=5000
MONGO_URL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BRONZE_PRICE_ID=price_...
STRIPE_SILVER_PRICE_ID=price_...
STRIPE_GOLD_PRICE_ID=price_...

# Resend email service. OTP_FROM_EMAIL must use a sender/domain verified in your Resend account.
RESEND_API_KEY=re_...
OTP_FROM_EMAIL=InstAI <verified-sender@your-verified-domain.com>

# Existing Twilio service
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
